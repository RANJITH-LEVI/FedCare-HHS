{
  "expo": {
    "name": "FedCare Mobile: Heart AI",
    "slug": "fedcare-heart-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FedCare needs camera access to scan patient lab reports and ECG documents.",
        "NSPhotoLibraryUsageDescription": "FedCare needs photo access to select patient clinical reports for AI extraction."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.anonymous.fedcareheartmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
